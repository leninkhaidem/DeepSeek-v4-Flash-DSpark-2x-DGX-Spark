# Install only with the separate spark-model deepseek-v4-flash-dspark target.
[Unit]
Description=DeepSeek V4 Flash Vision-Exp DSpark on 2x DGX Spark (127.0.0.1:8888)
Wants=network-online.target deepseek-v4-flash-dspark-journal.service
After=network-online.target docker.service
Requires=docker.service
Conflicts=deepseek-ds4.service qwen38-sglang-upstream-prefill-ab.service qwen38-flash-next-hybrid-vllm.service ornith-nextn-r94-sglang.service ornith-nextn-fp8-sglang.service ling-sglang.service glm53-flash-exl3.service qwen38-flash-next-dual-vllm.service glm53-flash-nvfp4-dflash2.service

[Service]
Type=oneshot
User=lenin
Group=lenin
SupplementaryGroups=docker
WorkingDirectory=/home/lenin/ai/deepseek-v4-flash-dspark-2x
ExecStart=/home/lenin/ai/deepseek-v4-flash-dspark-2x/start-deepseek-v4-flash-dspark.sh
ExecStop=/home/lenin/ai/deepseek-v4-flash-dspark-2x/stop-deepseek-v4-flash-dspark.sh
RemainAfterExit=yes
Restart=no
SuccessExitStatus=3
TimeoutStartSec=35min
TimeoutStopSec=10min
KillMode=process
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
